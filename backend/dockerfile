# Use an official lightweight Python image
FROM python:3.12-slim

# Set the working directory inside the container
WORKDIR /app

# Copy the requirements file first to leverage Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire backend source code to the working directory
COPY . .

# Documented default port. Render overrides this at runtime via $PORT.
EXPOSE 8000

# Bind to 0.0.0.0 and use Render's injected $PORT if present, falling back
# to 8000 for local `docker run` testing. Shell form (not exec form) is
# required here so the ${PORT} variable is actually expanded.
CMD sh -c "uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}"
